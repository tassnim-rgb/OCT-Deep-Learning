# Copy this file to `.env` (root of the project) and fill in real values.
# `.env` is gitignored and never committed. Values exported in your shell
# take precedence over this file (the loader never overrides real env vars).

# --- LLM agent (Tool 5): pick one provider (Cerebras used by default) ---
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Generic OpenAI-compatible endpoint (optional; overrides the table above)
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- Embeddings (Tool 4 notebooks) ---
GOOGLE_API_KEY=

# --- Agent behaviour ---
FAST_MODE=true
MAX_TURNS=4
MAX_COMPLETION_TOKENS=300
TEMPERATURE=0.0
REASONING_EFFORT=low